        "commonmark",
        "cmark",
        "djot",
        "docutils",
        "asciidoctor",
        "md4c"
      ],
      "expected": {
        "code": "unsupported-node",
        "fidelity": "degraded",
        "path": "/children/0/children/1"
      },
      "retained": "marked"
